# Clinic Management API — copy to .env and adjust per environment.
# Read by app/lib/api/client.ts; never hardcode this in application code.

# Server-side (loaders, actions, the SSR entry).
API_BASE_URL=https://clinic-mvp-backend.auxiliarynetwork.com/api/v1

# Browser-side, for any component that fetches directly. Must match the value
# above unless the browser reaches the API on a different host.
VITE_API_BASE_URL=https://clinic-mvp-backend.auxiliarynetwork.com/api/v1

# Signs the session cookie that holds the JWT pair (app/lib/auth.server.ts).
# Required in production; generate with `openssl rand -hex 32`.
SESSION_SECRET=change-me
